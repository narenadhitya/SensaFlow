# Copy to .env and add your key. .env is git-ignored - never commit a real key.
# Free key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: override the model (default chain: nvidia/nemotron-3-super-120b-a12b:free, then openrouter/free)
# OPENROUTER_MODEL=

# Telegram fault alerts (see README -> Telegram alerts). Sent after `python pipeline.py --predict <file>`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_MIN_SEVERITY=HIGH        # or MEDIUM
# TELEGRAM_MAX_ALERTS=5
# TELEGRAM_ALL_CLEAR=0              # 1 = also message when a run has no alerts
# SENSAFLOW_DASHBOARD_URL=http://localhost:8501
